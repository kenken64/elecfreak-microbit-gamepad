# Container / Railway runtime variables (do not commit real secrets).
GP_DATA_DIR=/data

# Match MICROBIT_GAMEPAD_SESSION_SECRET on 2ndBrain.ceo (at least 32 bytes).
MICROBIT_GAMEPAD_SESSION_SECRET=replace_with_a_random_secret_at_least_32_bytes

# Match MARKETPLACE_LAUNCH_VERIFY_SECRET on 2ndBrain.ceo (a different secret).
MARKETPLACE_LAUNCH_VERIFY_URL=https://2ndbrain.ceo/api/marketplace/launch-session/verify
MARKETPLACE_LAUNCH_VERIFY_SECRET=replace_with_a_different_random_secret_at_least_32_bytes
